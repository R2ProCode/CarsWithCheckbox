@using HW_260316_CarsWithCheckboxes
@model DisplayCarsViewModel

@{
	ViewData["Title"] = "Home Page";
}

<div class="container py-4">
    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-header bg-dark text-white rounded-top-4 d-flex justify-content-between align-items-center p-3">
            <h2 class="mb-0">
                <i class="bi bi-car-front-fill me-2"></i>Cars List
            </h2>

            <span class="badge bg-primary fs-6">
                @Model.Cars.Count Cars
            </span>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-dark table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Make</th>
                            <th>Model</th>
                            <th>
                                <div class="d-flex align-items-center">
                                    Year
                                    <a class="btn btn-outline-light rounded-pill btn-sm ms-2"
                                       href="/home/index?sort=@(Model.CurrentSort == "asc" ? "desc" : "asc")">
                                        <i class="@(Model.CurrentSort == "asc"
                                            ? "bi bi-sort-up"
                                            : "bi bi-sort-down")"></i>
                                    </a>
                                </div>
                            </th>
                            <th>Price</th>
                            <th>Type</th>
                            <th>Leather</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var car in Model.Cars)
                        {
                            <tr>
                                <td>
                                    <span class="fw-semibold">
                                        @car.Make
                                    </span>
                                </td>

                                <td>@car.Model</td>

                                <td>
                                    <span class="badge bg-info text-dark">
                                        @car.Year
                                    </span>
                                </td>

                                <td>
                                    <span class="fw-bold text-success">
                                        @car.Price.ToString("C")
                                    </span>
                                </td>

                                <td>
                                    <span class="badge bg-secondary rounded-pill">
                                        @car.CarType
                                    </span>
                                </td>

                                <td>
                                    @if (car.HasLeatherSeats)
                                    {
                                        <span class="badge bg-success rounded-pill">
                                            <i class="bi bi-check-lg"></i>
                                            Yes
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger rounded-pill">
                                            <i class="bi bi-x-lg"></i>
                                            No
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>